# Salin menjadi .streamlit/secrets.toml (lokal, sudah di-.gitignore)
# atau tempel isinya di Streamlit Community Cloud > App > Settings > Secrets.
# JANGAN commit kredensial asli.

# PostgreSQL (Supabase / Neon) - cukup salah satu: PG_URL ATAU PG_HOST+...
PG_URL = "postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
# PG_HOST = "..."
# PG_PORT = "5432"
# PG_DB   = "postgres"
# PG_USER = "postgres"
# PG_PASS = "..."
# PG_SSLMODE = "require"

# MongoDB Atlas
MONGO_URI = "mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority"
MONGO_DB = "karhutla_db"
MONGO_COLLECTION = "telemetri_sensor"
